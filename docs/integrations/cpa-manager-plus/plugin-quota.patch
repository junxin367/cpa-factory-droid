diff --git a/apps/web/src/features/accounts/model/pluginQuota.ts b/apps/web/src/features/accounts/model/pluginQuota.ts
new file mode 100644
--- /dev/null
+++ b/apps/web/src/features/accounts/model/pluginQuota.ts
@@ -0,0 +1,98 @@
+import type { AuthFileItem, CredentialScopedQuotaState } from '@/types';
+import { apiClient, createScopedApiRequestConfig, type ApiClientRequestScope } from '@/services/api/client';
+import { isQuotaRefreshSupportedProvider } from '@/features/authFiles/constants';
+
+export interface PluginQuotaWindow {
+  id: string;
+  label: string;
+  group: string;
+  remainingPercent: number | null;
+  resetAtMs: number | null;
+  durationSeconds: number | null;
+  kind: 'five_hour' | 'daily' | 'weekly' | 'monthly' | 'unknown';
+}
+
+export interface PluginQuotaState extends CredentialScopedQuotaState {
+  status: 'loading' | 'success' | 'error';
+  windows: PluginQuotaWindow[];
+  planType: string | null;
+  error?: string;
+  errorStatus?: number;
+}
+
+const record = (value: unknown): Record<string, unknown> =>
+  typeof value === 'object' && value !== null && !Array.isArray(value)
+    ? value as Record<string, unknown> : {};
+const text = (value: unknown): string => typeof value === 'string' ? value.trim() : '';
+
+export const isPluginQuotaFile = (file: AuthFileItem): boolean =>
+  !isQuotaRefreshSupportedProvider(text(file.provider || file.type)) &&
+  (file.supports_quota === true || file.supportsQuota === true) &&
+  Boolean(text(file.quota_provider || file.quotaProvider));
+
+const windowDuration = (name: string): Pick<PluginQuotaWindow, 'kind' | 'durationSeconds'> => {
+  if (/five[_ -]?hour|5\s*(?:小时|hours?)/i.test(name)) return { kind: 'five_hour', durationSeconds: 18000 };
+  if (/weekly|7\s*(?:天|days?)/i.test(name)) return { kind: 'weekly', durationSeconds: 604800 };
+  if (/monthly|30\s*(?:天|days?)/i.test(name)) return { kind: 'monthly', durationSeconds: 2592000 };
+  if (/daily|24\s*(?:小时|hours?)/i.test(name)) return { kind: 'daily', durationSeconds: 86400 };
+  return { kind: 'unknown', durationSeconds: null };
+};
+
+export const normalizePluginQuota = (
+  payload: unknown
+): Pick<PluginQuotaState, 'windows' | 'planType'> => {
+  const data = record(payload);
+  const windows: PluginQuotaWindow[] = [];
+  const groups = Array.isArray(data.groups) ? data.groups : [];
+  groups.forEach((rawGroup, groupIndex) => {
+    const group = record(rawGroup);
+    const groupLabel = text(group.displayName) || text(group.id) || `额度 ${groupIndex + 1}`;
+    const buckets = Array.isArray(group.buckets) ? group.buckets : [];
+    buckets.forEach((rawBucket, bucketIndex) => {
+      const bucket = record(rawBucket);
+      const name = text(bucket.window);
+      const label = text(bucket.description) || name || `${groupLabel} ${bucketIndex + 1}`;
+      const fraction = bucket.remainingFraction;
+      const reset = text(bucket.resetTime) ? Date.parse(text(bucket.resetTime)) : NaN;
+      windows.push({
+        id: `${groupIndex}:${name || bucketIndex}`,
+        label,
+        group: groupLabel,
+        remainingPercent: typeof fraction === 'number' && Number.isFinite(fraction) &&
+          fraction >= 0 && fraction <= 1 ? fraction * 100 : null,
+        resetAtMs: Number.isFinite(reset) && reset > 0 ? reset : null,
+        ...windowDuration(name),
+      });
+    });
+  });
+  return { windows, planType: text(record(data.subscription).plan) || null };
+};
+
+export const fetchPluginQuota = async (
+  file: AuthFileItem,
+  requestScope: ApiClientRequestScope
+): Promise<Pick<PluginQuotaState, 'windows' | 'planType'>> => {
+  const authIndex = file.authIndex ?? file.auth_index;
+  if (authIndex === null || authIndex === undefined || String(authIndex).trim() === '') {
+    throw new Error('凭证缺少 auth_index，请刷新凭证列表。');
+  }
+  let pluginId = text(file.quota_plugin_id || file.quotaPluginId);
+  if (!pluginId) {
+    const payload = await apiClient.get<{ plugins?: unknown[] }>(
+      '/plugins', createScopedApiRequestConfig(requestScope)
+    );
+    const provider = text(file.quota_provider || file.quotaProvider).toLowerCase();
+    const plugin = (payload.plugins ?? []).map(record).find((item) =>
+      item.registered === true && item.effective_enabled === true && item.supports_quota === true &&
+      (text(item.quota_provider).toLowerCase() === provider || text(item.id).toLowerCase() === provider)
+    );
+    pluginId = text(plugin?.id);
+  }
+  if (!pluginId) throw new Error('额度插件尚未就绪，请检查插件状态。');
+  const data = await apiClient.post<unknown>(
+    `/plugins/${encodeURIComponent(pluginId)}/quota`,
+    { auth_index: String(authIndex) },
+    createScopedApiRequestConfig(requestScope)
+  );
+  return normalizePluginQuota(data);
+};
